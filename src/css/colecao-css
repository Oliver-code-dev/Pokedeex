/* Minha coleção — complementa global.css e pokedex.css */


.col-secao { margin-bottom: var(--espaco-5); }
.col-cabecalho { display: flex; justify-content: space-between; align-items: baseline; padding-inline: clamp(0rem, 2vw, 2.4rem); margin-bottom: var(--espaco-3); }
.col-titulo { font-size: clamp(1.5rem, 3vw, 2.2rem); font-weight: 800; text-transform: uppercase; line-height: 1.1; }
.col-alternar { background: none; border: 0; padding: 0; }


.card-pokemon--saindo { animation: sair 0.3s ease forwards; }
@keyframes sair { to { opacity: 0; transform: scale(0.85); } }
.card-pokemon--vazio { opacity: 0.55; }
.card-pokemon--vazio:hover { transform: none; box-shadow: var(--sombra-card); }


/* ---------- Cards de comparação ---------- */
.grade-comparacoes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--espaco-4); }
.cmp-card {
  position: relative; background: var(--cor-fundo-medio); border: 3px solid rgba(255, 255, 255, 0.28);
  box-shadow: 5px 5px 0 rgba(0, 0, 0, 0.4); padding: 1.6rem 1rem 0.8rem; transition: transform var(--transicao);
  animation: subir 0.5s ease both;
}
.cmp-card:hover { transform: translateY(-5px); }
.cmp-card--saindo { animation: sair 0.3s ease forwards; }
.cmp-card__titulo {
  position: absolute; top: -0.9rem; left: 50%; transform: translateX(-50%); max-width: 70%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  background: var(--cor-fundo-escuro); border: 2px solid rgba(255, 255, 255, 0.6); border-radius: 999px; padding: 0.1rem 1rem; font-size: 0.85rem; text-transform: uppercase;
}
.cmp-card__link { display: block; }
.cmp-card__duelo { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 0.5rem; background: var(--cor-fundo-medio); border: 2px solid #0a2447; padding: 0.5rem; }
.cmp-card__lado { text-align: center; min-width: 0; }
.cmp-mini {
  aspect-ratio: 3 / 4; display: grid; place-items: center; background: var(--cor-card); border: 3px solid #000; border-radius: 40% 40% 0 0 / 22% 22% 0 0; overflow: hidden;
}
.cmp-mini img { width: 90%; filter: drop-shadow(0 4px 4px rgba(0, 0, 0, 0.5)); transition: transform 0.3s ease; }
.cmp-card:hover .cmp-mini img { transform: scale(1.08); }
.cmp-mini span { font-family: Arial, sans-serif; font-size: 3.4rem; line-height: 1; }
.cmp-card__vs { font-weight: 800; font-size: 1.2rem; color: #0a2447; }
.cmp-card__nome { display: block; margin-top: 0.4rem; font-size: 0.85rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.cmp-card__acoes { position: absolute; top: 0.5rem; right: 0.6rem; display: flex; gap: 0.2rem; z-index: 2; }
.cmp-card__acoes button { background: none; border: 0; padding: 0.15rem; color: #fff; transition: transform var(--transicao); }
.cmp-card__acoes button:hover { transform: scale(1.2); }
.cmp-card__acoes svg { width: 22px; height: 22px; }
.cmp-card__acoes .btn-favorito svg { width: 24px; height: 24px; }
.cmp-card__remover:hover { color: var(--cor-erro) !important; }


@media (max-width: 1000px) { .grade-comparacoes { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 600px) { .grade-comparacoes { grid-template-columns: 1fr; } .col-cabecalho { padding-inline: 0; } }
